<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Chatify — Direct Messages</title>
  <link rel="stylesheet" href="/css/style.css"/>
  <style>
    /* Unified SPA Layout */
    .app-container { max-width: 1200px; margin: 30px auto; padding: 0 20px; position: relative; z-index: 10; }
    .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; color: white; }
    
    .app-layout { 
      display: flex; height: 80vh; background: var(--panel-bg); 
      border-radius: 16px; overflow: hidden; 
      border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(10px); 
    }
    
    /* ── Sidebar (Friends) ── */
    .sidebar { width: 320px; border-right: 1px solid rgba(255,255,255,0.05); display: flex; flex-direction: column; background: rgba(0,0,0,0.2); }
    .sidebar-header { padding: 20px; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .friends-list { flex: 1; overflow-y: auto; padding: 10px; }
    
    .friend-item { 
      display: flex; align-items: center; padding: 12px 15px; border-radius: 8px; 
      cursor: pointer; color: white; transition: 0.2s; margin-bottom: 5px;
    }
    .friend-item:hover { background: rgba(255,255,255,0.05); }
    .friend-item.active { background: rgba(79, 70, 229, 0.2); border: 1px solid rgba(79, 70, 229, 0.5); }
    
    /* Online/Offline Dots */
    .status-dot { width: 10px; height: 10px; border-radius: 50%; margin-right: 12px; transition: 0.3s; }
    .status-online { background-color: #10b981; box-shadow: 0 0 8px #10b981; }
    .status-offline { background-color: #555; }
    
    .btn-small { padding: 6px 12px; background: var(--accent); border: none; color: white; border-radius: 6px; cursor: pointer; font-size: 0.8rem;}
    .btn-logout { background: rgba(255, 50, 50, 0.2); padding: 8px 16px; color: #ff6b6b; border: 1px solid rgba(255, 50, 50, 0.4); border-radius: 8px; cursor: pointer; }

    /* ── Main Chat Area ── */
    .main-chat { flex: 1; display: flex; flex-direction: column; background: rgba(0,0,0,0.4); position: relative; }
    .empty-chat { flex: 1; display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.4); font-style: italic; }
    
    .chat-header { padding: 20px; background: rgba(0,0,0,0.3); border-bottom: 1px solid rgba(255,255,255,0.05); display: none; }
    .chat-header h3 { margin: 0; color: white; }
    
    .chat-messages { flex: 1; padding: 20px; overflow-y: auto; display: none; flex-direction: column; gap: 15px; }
    .msg { max-width: 70%; padding: 12px 16px; border-radius: 12px; color: white; line-height: 1.4; position: relative; }
    .msg-mine { background: var(--accent); align-self: flex-end; border-bottom-right-radius: 2px; }
    .msg-theirs { background: rgba(255,255,255,0.1); align-self: flex-start; border-bottom-left-radius: 2px; }
    .msg-sender { font-size: 0.75rem; opacity: 0.7; margin-bottom: 4px; display: block; }
    .msg-time { font-size: 0.7rem; opacity: 0.6; margin-top: 6px; display: block; text-align: right; }
    
    .chat-input-area { padding: 20px; background: rgba(0,0,0,0.3); display: none; gap: 10px; border-top: 1px solid rgba(255,255,255,0.05); }
    .chat-input { flex: 1; padding: 14px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.5); color: white; font-family: inherit; }
  </style>
</head>
<body>

<div class="glow-blob glow-blob-1"></div>
<div class="glow-blob glow-blob-2"></div>

<div class="app-container">
  <div class="header">
    <h2><span id="my-username">Loading...</span>'s Chatify</h2>
    <button class="btn-logout" id="btn-logout">Logout</button>
  </div>

  <div class="app-layout">
    
    <!-- LEFT: Sidebar -->
    <div class="sidebar">
      <div class="sidebar-header">
        <input type="text" id="search-input" class="form-input" placeholder="Search to add friends..." style="padding: 10px; font-size: 0.9rem;" autocomplete="off">
        <div id="search-results" style="margin-top: 10px;"></div>
      </div>
      <div class="friends-list" id="friends-list">
        <div style="text-align: center; color: #888; margin-top: 20px;">Loading friends...</div>
      </div>
    </div>

    <!-- RIGHT: Main Chat Area -->
    <div class="main-chat" id="main-chat">
      <!-- Empty State -->
      <div class="empty-chat" id="empty-chat">Select a friend to start chatting</div>
      
      <!-- Active Chat UI -->
      <div class="chat-header" id="chat-header">
        <h3>💬 Chatting with <span id="current-friend-name" style="color: var(--accent);"></span></h3>
      </div>
      <div class="chat-messages" id="messages"></div>
      <div class="chat-input-area" id="chat-input-area">
        <input type="text" id="msg-input" class="chat-input" placeholder="Type a message..." autocomplete="off">
        <button id="btn-send" class="btn-submit" style="width: auto; padding: 0 24px;">Send</button>
      </div>
    </div>

  </div>
</div>

<div class="toast" id="toast"></div>

<!-- Load Socket.io -->
<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  let myName = null;
  let activeRoomCode = null;
  let onlineUsers = new Set();
  
  // UI Elements
  const messagesDiv = document.getElementById('messages');
  const emptyChatDiv = document.getElementById('empty-chat');
  const chatHeader = document.getElementById('chat-header');
  const chatInputArea = document.getElementById('chat-input-area');
  const msgInput = document.getElementById('msg-input');

  const toast = (msg, type='error') => {
    const el = document.getElementById('toast');
    el.textContent = msg; el.className = `toast ${type} show`;
    setTimeout(() => el.classList.remove('show'), 3000);
  };

  // ── 1. Boot up: Load User & Connect Socket ──
  async function loadDashboard() {
    try {
      const r = await fetch('/api/users/me');
      const d = await r.json();
      if (!d.success) return window.location.href = '/'; 

      myName = d.user.username;
      document.getElementById('my-username').textContent = myName;

      // Tell the server we are online for the very first time
      if (socket.connected) {
        socket.emit('register-presence', myName);
      }
      
      renderFriends(d.user.friends);
    } catch (err) { toast('Error loading dashboard'); }
  }

  socket.on('connect', () => {
    // If myName already exists, it means the server restarted and we are reconnecting!
    if (myName) {
      // 1. Tell the server we are still online
      socket.emit('register-presence', myName);
      
      // 2. Put us back into the chat room we were looking at
      if (activeRoomCode) {
        socket.emit('join-room', { code: activeRoomCode, name: myName });
      }
    }
  });

  // ── 2. Socket: Presence Listeners ──
  socket.on('online-users-list', (users) => {
    onlineUsers = new Set(users);
    updateAllFriendStatuses();
  });

  socket.on('user-status', ({ username, online }) => {
    if (online) onlineUsers.add(username);
    else onlineUsers.delete(username);
    
    // Update the specific friend's dot in the UI
    const dot = document.getElementById(`status-${username}`);
    if (dot) {
      dot.className = `status-dot ${online ? 'status-online' : 'status-offline'}`;
    }
  });

  // ── 3. Render Friends List ──
  function renderFriends(friends) {
    const container = document.getElementById('friends-list');
    if (!friends || friends.length === 0) {
      container.innerHTML = `<div style="text-align:center; color:#888; margin-top:20px;">No friends yet. Search above!</div>`;
      return;
    }

    container.innerHTML = friends.map(f => {
      const isOnline = onlineUsers.has(f.username);
      return `
      <div class="friend-item" id="friend-box-${f._id}" onclick="openChat('${f._id}', '${f.username}')">
        <div class="status-dot ${isOnline ? 'status-online' : 'status-offline'}" id="status-${f.username}"></div>
        <span style="font-weight: 600;">${f.username}</span>
      </div>
    `}).join('');
  }

  function updateAllFriendStatuses() {
    document.querySelectorAll('.friend-item').forEach(el => {
      const username = el.querySelector('span').textContent;
      const dot = el.querySelector('.status-dot');
      dot.className = `status-dot ${onlineUsers.has(username) ? 'status-online' : 'status-offline'}`;
    });
  }

  // ── 4. Open a Chat (The Magic Switch) ──
  async function openChat(friendId, friendName) {
    // UI Highlights
    document.querySelectorAll('.friend-item').forEach(el => el.classList.remove('active'));
    document.getElementById(`friend-box-${friendId}`).classList.add('active');
    document.getElementById('current-friend-name').textContent = friendName;

    try {
      // Get the unique room code for this friend pair
      const r = await fetch('/api/rooms/dm', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ friendId })
      });
      const d = await r.json();
      
      if (d.success) {
        // Tell Socket.io to switch to this room!
        socket.emit('join-room', { code: d.code, name: myName });
      }
    } catch (err) { toast('Error starting chat.'); }
  }

  // ── 5. Socket: Chat Logic ──
  const scrollToBottom = () => messagesDiv.scrollTop = messagesDiv.scrollHeight;

  const appendMessage = (data) => {
    const isMine = data.sender === myName;
    const div = document.createElement('div');
    div.className = `msg ${isMine ? 'msg-mine' : 'msg-theirs'}`;
    div.innerHTML = `
      ${!isMine ? `<span class="msg-sender">${data.sender}</span>` : ''}
      ${data.text}
      <span class="msg-time">${data.time || new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span>
    `;
    messagesDiv.appendChild(div);
    scrollToBottom();
  };

  socket.on('room-joined', (data) => {
    activeRoomCode = data.code;
    
    // Reveal the Chat UI
    emptyChatDiv.style.display = 'none';
    chatHeader.style.display = 'block';
    messagesDiv.style.display = 'flex';
    chatInputArea.style.display = 'flex';
    
    // Clear old messages and load history
    messagesDiv.innerHTML = '';
    if (data.history && data.history.length > 0) {
      data.history.forEach(m => appendMessage(m));
    }
  });

  socket.on('new-message', (data) => {
    appendMessage(data);
  });

  // ── 6. Sending Messages ──
  const sendMessage = () => {
    if (!activeRoomCode) return;
    const text = msgInput.value.trim();
    if (!text) return;
    
    socket.emit('send-message', { text });
    msgInput.value = '';
    msgInput.focus();
  };

  document.getElementById('btn-send').addEventListener('click', sendMessage);
  msgInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') sendMessage(); });

  // ── 7. Search & Add Friend (Unchanged Logic) ──
  document.getElementById('search-input').addEventListener('input', async (e) => {
    const q = e.target.value.trim();
    const container = document.getElementById('search-results');
    if (q.length < 2) { container.innerHTML = ''; return; }
    try {
      const r = await fetch(`/api/users/search?q=${q}`);
      const d = await r.json();
      container.innerHTML = d.users.map(u => `
        <div style="display:flex; justify-content:space-between; margin-bottom:5px; align-items:center;">
          <span style="color:white; font-size:0.9rem;">@${u.username}</span>
          <button class="btn-small" onclick="addFriend('${u._id}')">Add</button>
        </div>
      `).join('');
    } catch (err) {}
  });

  async function addFriend(friendId) {
    try {
      const r = await fetch('/api/users/add-friend', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ friendId })
      });
      const d = await r.json();
      if (d.success) {
        document.getElementById('search-input').value = '';
        document.getElementById('search-results').innerHTML = '';
        loadDashboard(); // Reload friends list
      }
    } catch (err) {}
  }

  // ── Logout ──
  document.getElementById('btn-logout').addEventListener('click', async () => {
    await fetch('/api/auth/logout', { method: 'POST' });
    window.location.href = '/';
  });

  // Start App
  loadDashboard();
</script>
</body>
</html>